# Store and check out text files with LF line endings on every platform, regardless
# of core.autocrlf. rustfmt and the Rust toolchain are happy with LF on Windows.
* text=auto eol=lf

# Windows-only files that need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.db binary
*.png binary
*.ico binary
